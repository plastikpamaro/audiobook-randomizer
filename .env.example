# Öffentliche URL hinter Caddy, ohne abschließenden Slash
APP_ORIGIN=https://hoerspiel.example.com

# PostgreSQL
POSTGRES_DB=hoerspiel
POSTGRES_USER=hoerspiel
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://hoerspiel:replace-with-a-long-random-password@postgres:5432/hoerspiel

# Mindestens 32 zufällige Bytes; z. B. `openssl rand -base64 48`
SESSION_SECRET=replace-with-a-long-random-secret
SETUP_TOKEN=replace-with-a-one-time-setup-token

TZ=Europe/Berlin
CADDY_NETWORK=caddy
